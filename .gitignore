# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Private User Data & Submissions (KVKK / Privacy Protection)
/content/applications/*.json
!/content/applications/.gitkeep.md
/content/contact/*.json
!/content/contact/.gitkeep.md

# Environment & Secret Files (API Keys, Passwords)
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Build Outputs
/coverage
/.next/
/out/
/build

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Keys & Certificates
*.pem
*.key
*.p12

# Vercel & IDE
.vercel
.vscode
.idea
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts
.kombai/
